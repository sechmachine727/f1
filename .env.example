# LLM provider API key (set the one matching your registries/llm_config.hocon provider)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Custom OpenAI-compatible endpoint. Set all three to route the agent team at
# any OpenAI-compatible server (Ollama, LM Studio, vLLM, LiteLLM, OpenRouter).
# See README, section "Custom OpenAI-compatible endpoints".
# LLM_CLASS=openai
# LLM_MODEL_NAME=llama3.1
# OPENAI_API_BASE=http://127.0.0.1:11434/v1
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# GOOGLE_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# Observability (optional — see README.md § Observability)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
