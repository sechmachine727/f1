<Window
    x:Class="F1Telemetry.ControlCenter.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Padding="24,18,24,10" Spacing="4">
            <TextBlock x:Name="TitleText" Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="SubtitleText" Text="Configure the bundled telemetry server." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Padding="24,0,24,12" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Dashboard password" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="The web dashboard requires this password. Reset does not ask for the previous password and signs out every browser." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <PasswordBox x:Name="NewPasswordBox" Header="New password" PlaceholderText="At least 8 characters" />
                        <PasswordBox x:Name="ConfirmPasswordBox" Header="Confirm password" />
                        <Button x:Name="ResetPasswordButton" Content="Reset password" Click="ResetPassword_Click" />
                        <TextBlock x:Name="PasswordStatus" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Security" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <CheckBox x:Name="OriginCheckBox" Content="Validate browser Origin" />
                        <TextBlock Text="Reject browser requests whose Origin host differs from the dashboard host. Environment values override this setting." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Server" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <NumberBox x:Name="HttpPortBox" Grid.Row="0" Grid.Column="0" Header="Dashboard port" Minimum="1" Maximum="65535" />
                            <NumberBox x:Name="UdpPortBox" Grid.Row="0" Grid.Column="1" Header="Telemetry UDP port" Minimum="1" Maximum="65535" />
                        </Grid>
                        <TextBox x:Name="DataDirBox" Header="Data directory" IsReadOnly="True" />
                        <TextBlock x:Name="GameAddressText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <NumberBox x:Name="RecordingCapBox" Header="Recording cap (GB)" Minimum="1" Maximum="10000" />
                    </StackPanel>
                </Border>

                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Model endpoint" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBox x:Name="EndpointIdBox" Header="Endpoint ID" />
                        <TextBox x:Name="BaseUrlBox" Header="Base URL" PlaceholderText="https://provider.example/v1" />
                        <TextBox x:Name="ModelBox" Header="Model" />
                        <ComboBox x:Name="ProtocolBox" Header="Protocol" SelectedIndex="0">
                            <ComboBoxItem Content="chat_completions" />
                            <ComboBoxItem Content="responses" />
                        </ComboBox>
                        <PasswordBox x:Name="ApiKeyBox" Header="API key" PlaceholderText="Leave blank to keep the stored key" />
                        <TextBlock x:Name="ApiKeyStatus" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Search and voice" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ComboBox x:Name="SearchProviderBox" Header="Search provider" SelectedIndex="0">
                            <ComboBoxItem Content="disabled" />
                            <ComboBoxItem Content="tavily" />
                            <ComboBoxItem Content="searxng" />
                        </ComboBox>
                        <TextBox x:Name="SearchUrlBox" Header="Search base URL" />
                        <CheckBox x:Name="VoiceEnabledBox" Content="Enable native voice" />
                        <TextBox x:Name="VoiceUrlBox" Header="Voice provider base URL" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Padding="24,10,24,18" Spacing="8">
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" />
            <Button x:Name="SaveButton" Content="Save and start" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
